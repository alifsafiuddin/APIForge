# Frontend settings for local development. Copy to `.env.local` (git-ignored) if you need to change them.

# Where the Vite dev server proxies /api and /actuator (read by vite.config.ts, not exposed to the browser).
APIFORGE_BACKEND_URL=http://localhost:8081

# Leave empty to use the proxy (recommended). Set to an absolute URL such as http://localhost:8081 to call
# the backend cross-origin instead; that origin must then be allowed by APIFORGE_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=
