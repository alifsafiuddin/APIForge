# APIForge AI — local environment template.
# Copy to `.env` (git-ignored) and replace every placeholder:
#   cp .env.example .env            (PowerShell: Copy-Item .env.example .env)
# The backend dev profile and Docker Compose both read `.env`.
# Never commit a real `.env`.

# ---- PostgreSQL (used by docker compose and the backend) ----
APIFORGE_DB_NAME=apiforge
APIFORGE_DB_USER=apiforge
# REQUIRED: choose a local password. Docker Compose refuses to start without it.
APIFORGE_DB_PASSWORD=<choose-a-local-db-password>
# Host port published for PostgreSQL. Change it if 5432 is already in use.
APIFORGE_DB_PORT=5432

# ---- Backend ----
APIFORGE_SERVER_PORT=8081
# Comma-separated browser origins allowed to call the API directly (no wildcards).
APIFORGE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Authentication ----
# Set to false to stop self-registration (existing users can still sign in).
APIFORGE_AUTH_REGISTRATION_ENABLED=true
# Mark session and CSRF cookies Secure. Must be true whenever the app is served over HTTPS.
APIFORGE_COOKIE_SECURE=false
APIFORGE_SESSION_IDLE_TIMEOUT=30m
APIFORGE_SESSION_ABSOLUTE_TIMEOUT=12h

# ---- Specification import ----
# Maximum OpenAPI document size (uploads and pasted text).
APIFORGE_SPEC_MAX_SIZE=5MB

# ---- Secrets (environment variables marked secret are encrypted with this key) ----
# Base64 of 32 random bytes, e.g. `openssl rand -base64 32`. The dev profile falls back to a public,
# development-only key when this is empty; the prod profile refuses to start without a real one.
APIFORGE_SECRETS_KEY=
# Label stored with each encrypted value (change it when rotating the key).
APIFORGE_SECRETS_KEY_ID=k1

# ---- Outbound requests (test execution) ----
# The dev profile trusts only the local sample API at localhost:8090 / 127.0.0.1:8090
# (samples/warehouse-lab-server.mjs). Deployed environments block every private address.
APIFORGE_OUTBOUND_CONNECT_TIMEOUT=5s
APIFORGE_OUTBOUND_TOTAL_DEADLINE=30s
# Only for a self-hosted single-user install that must reach local targets with the prod profile.
APIFORGE_OUTBOUND_ALLOW_TRUSTED_IN_PROD=false

# ---- Local AI (optional; docs/AI.md) ----
# Without Ollama every other feature works. The URL is server configuration: http(s)://host:port only.
APIFORGE_AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b for 16 GB RAM or a 6 GB GPU; llama3.2:3b for 8 GB machines (docs/AI_EVALUATION.md).
APIFORGE_AI_MODEL=qwen2.5:7b
APIFORGE_AI_REQUEST_TIMEOUT=120s
# Model calls processed at once, and the context window requested from Ollama.
APIFORGE_AI_MAX_CONCURRENT=1
APIFORGE_AI_CONTEXT_TOKENS=8192
