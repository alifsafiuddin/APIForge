# APIForge AI — local environment template.
# Copy to `.env` (git-ignored) and replace every placeholder:
#   cp .env.example .env            (PowerShell: Copy-Item .env.example .env)
# The backend dev profile and Docker Compose both read `.env`.
# Never commit a real `.env`.

# ---- PostgreSQL (used by docker compose and the backend) ----
APIFORGE_DB_NAME=apiforge
APIFORGE_DB_USER=apiforge
# REQUIRED: choose a local password. Docker Compose refuses to start without it.
APIFORGE_DB_PASSWORD=<choose-a-local-db-password>
# Host port published for PostgreSQL. Change it if 5432 is already in use.
APIFORGE_DB_PORT=5432

# ---- Backend ----
APIFORGE_SERVER_PORT=8081
# Comma-separated browser origins allowed to call the API directly (no wildcards).
APIFORGE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Authentication ----
# Set to false to stop self-registration (existing users can still sign in).
APIFORGE_AUTH_REGISTRATION_ENABLED=true
# Mark session and CSRF cookies Secure. Must be true whenever the app is served over HTTPS.
APIFORGE_COOKIE_SECURE=false
APIFORGE_SESSION_IDLE_TIMEOUT=30m
APIFORGE_SESSION_ABSOLUTE_TIMEOUT=12h

# ---- Specification import ----
# Maximum OpenAPI document size (uploads and pasted text).
APIFORGE_SPEC_MAX_SIZE=5MB
